{
  "manifest_version": 3,
  "name": "Groupback",
  "version": "0.1.3",
  "description": "Turn every new tab into a private history dashboard and restore tab groups or recently closed windows in one click.",
  "minimum_chrome_version": "102",
  "permissions": ["history", "sessions", "storage", "tabs", "tabGroups"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
